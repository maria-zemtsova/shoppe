{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": [
      "nuxt",
      "vite/client",
      "@testing-library/vue",
      "@testing-library/jest-dom",
      "vitest/globals"
    ],
    "strict": true,
    "moduleResolution": "bundler"
  },

  "include": [
    "**/*.ts",
    "**/*.vue",
    ".nuxt/types/**/*.d.ts",
    "types/**/*.ts",
    "stores/cart.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".nuxt", ".output", "dist"]
}
